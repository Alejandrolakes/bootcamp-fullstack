<div class="container">
    <h1 class="text-center my-5">Listado Bicicletas</h1>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Año</th>
                <th>Disponibilidad</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            {{#each bicicletas as |bicicleta|}}
                <tr>
                    <td>{{bicicleta.marca}}</td>
                    <td>{{bicicleta.modelo}}</td>
                    <td>{{bicicleta.year}}</td>
                    <td>{{bicicleta.disponible}}</td>
                    <td class="d-flex gap-2">
                        <a href="/bicicletas/{{bicicleta.id}}" class="btn btn-primary btn-sm">Detalles</a>
                        <a href="" class="btn btn-warning btn-sm">Editar</a>
                        <form action="">
                            <button class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </td>
                </tr>
            {{/each}}
        </tbody>

    </table>
</div>